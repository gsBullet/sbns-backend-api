# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
MONGO_URI='mongodb://localhost:27017/sbns_org'
# Production example:

# MONGO_URI=mongodb+srv://sbns_org:sbns_org@cluster0.0fsdqn6.mongodb.net/sbns_org

# mongodb+srv://<db_username>:<db_password>@cluster0.0fsdqn6.mongodb.net/?appName=Cluster0

# MONGO_URI=mongodb+srv://sbns_org:sbns_org@cluster0.0fsdqn6.mongodb.net/sbns_org

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=asdfghjkl1234567890
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30

# ─── Client ───────────────────────────────────────────
CLIENT_URL=http://localhost:3000